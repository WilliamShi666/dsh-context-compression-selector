{
  "name": "dsh-context-compression-selector-runtime",
  "version": "0.1.0",
  "description": "Auditable context-compression runtime for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "assets/deepseek-v4/*",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/deepseek-v4-vision-exp/*"
  ],
  "scripts": {
    "bundle": "tsdown",
    "prepack": "pnpm run bundle",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts --project runtime",
    "pack:dry-run": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamShi666/dsh-context-compression-selector.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/WilliamShi666/dsh-context-compression-selector#readme",
  "bugs": {
    "url": "https://github.com/WilliamShi666/dsh-context-compression-selector/issues"
  },
  "author": "WilliamShi666",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "context",
    "compression",
    "plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-compaction": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0"
  }
}
